---
interface Props {
  mediaId: string;
  label: string;
  altDraft: string;
  ratio?: '16:9' | '4:3';
  priority?: boolean;
}

const {
  mediaId,
  label,
  altDraft,
  ratio = '4:3',
  priority = false,
} = Astro.props;
---

<figure
  class="media-placeholder"
  data-ratio={ratio}
  data-media-id={mediaId}
  data-asset-status="placeholder"
  data-loading={priority ? 'priority-contract' : 'lazy-contract'}
  role="img"
  aria-label={`${label}. Planned alt text: ${altDraft}`}
>
  <span class="placeholder-brand" aria-hidden="true">KBBQGuide</span>
  <span class="placeholder-emblem" aria-hidden="true">
    <span></span><span></span><span></span>
  </span>
  <figcaption class="placeholder-label">
    {label}
    <span>Photography in production · frame {mediaId}</span>
  </figcaption>
</figure>
