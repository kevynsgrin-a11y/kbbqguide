---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { releaseState } from '../lib/release-state';
import StructuredData from '../components/StructuredData.astro';
import { canonicalUrl } from '../lib/seo';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  pageClass?: string;
  canonicalPath?: string;
  jsonLd?: readonly unknown[];
  socialImage?: string;
  socialImageAlt?: string;
  socialImageWidth?: number;
  socialImageHeight?: number;
  robotsContent?: 'noindex,nofollow,noarchive' | 'index,follow';
}

const {
  title,
  description,
  pageClass = '',
  canonicalPath = '/',
  jsonLd = [],
  socialImage,
  socialImageAlt,
  socialImageWidth,
  socialImageHeight,
  robotsContent,
} = Astro.props;
const siteName = 'KBBQGuide';
const canonical = canonicalUrl(canonicalPath);
const metaRobots = robotsContent ?? releaseState.metaRobots;
const canEmitStructuredData =
  releaseState.isIndexable && metaRobots === 'index,follow';
const isPreview = releaseState.mode !== 'public-launch';
const socialImageUrl = socialImage
  ? new globalThis.URL(socialImage, canonical).href
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={metaRobots} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#151713" />
    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {
      socialImageUrl && socialImageWidth && (
        <meta property="og:image:width" content={String(socialImageWidth)} />
      )
    }
    {
      socialImageUrl && socialImageHeight && (
        <meta property="og:image:height" content={String(socialImageHeight)} />
      )
    }
    {
      socialImageAlt && (
        <meta property="og:image:alt" content={socialImageAlt} />
      )
    }
    <meta
      name="twitter:card"
      content={socialImageUrl ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {
      socialImageAlt && (
        <meta name="twitter:image:alt" content={socialImageAlt} />
      )
    }
    {canEmitStructuredData && jsonLd.map((data) => <StructuredData {data} />)}
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    {
      isPreview && (
        <div class="preview-strip">
          KBBQGuide editorial preview · recipes await test-kitchen and expert
          review
        </div>
      )
    }
    <Header />
    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
