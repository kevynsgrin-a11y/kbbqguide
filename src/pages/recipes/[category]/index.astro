---
import { getCollection } from 'astro:content';
import registryData from '../../../../data/url-registry.json';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import MediaPlaceholder from '../../../components/MediaPlaceholder.astro';
import RecipeCard from '../../../components/RecipeCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  categories,
  categoryBySlug,
  type RecipeCategory,
} from '../../../lib/categories';
import { breadcrumbJsonLd, itemListJsonLd } from '../../../lib/seo';
import { registryPathById, type UrlRegistry } from '../../../lib/url-registry';
import type { CompleteRecipe } from '../../../schemas/recipe';

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { categorySlug: category.slug },
  }));
}

interface Props {
  categorySlug: RecipeCategory;
}

const { categorySlug } = Astro.props as Props;
const category = categoryBySlug(categorySlug);
const registry = registryData as UrlRegistry;
const recipes = (await getCollection('recipes'))
  .map((entry) => entry.data)
  .filter(
    (recipe): recipe is CompleteRecipe =>
      recipe.contentStatus === 'complete' && recipe.category === categorySlug,
  )
  .sort((a, b) => a.publicReleaseOrder - b.publicReleaseOrder);
const canonicalPath = registryPathById(registry, category.id);
const structuredData = [
  breadcrumbJsonLd([
    { name: 'Home', path: registryPathById(registry, 'SYS_HOME') },
    { name: 'Recipes', path: registryPathById(registry, 'SYS_RECIPES') },
    { name: category.label, path: canonicalPath },
  ]),
  itemListJsonLd(
    `${category.label} recipe drafts`,
    recipes.map((recipe) => ({
      name: recipe.title,
      path: registryPathById(registry, recipe.id),
    })),
  ),
];
---

<BaseLayout
  title={category.label}
  description={`${recipes.length} ${category.label.toLowerCase()} recipes with practical timing, sensory cues, and safety-aware guidance.`}
  canonicalPath={canonicalPath}
  jsonLd={structuredData}
  pageClass={`category-${category.accent}`}
>
  <header class="category-hero">
    <div class="shell hero-grid">
      <div>
        <Breadcrumbs
          items={[
            { label: 'Home', href: registryPathById(registry, 'SYS_HOME') },
            {
              label: 'Recipes',
              href: registryPathById(registry, 'SYS_RECIPES'),
            },
            { label: category.label },
          ]}
        />
        <p class="eyebrow">{category.eyebrow}</p>
        <h1>{category.label}</h1>
        <p class="lede">{category.description}</p>
        <p class="card-meta"><span>{recipes.length} recipes</span></p>
      </div>
      <MediaPlaceholder
        mediaId={`${category.id}-hero`}
        label={`${category.label} at the table`}
        altDraft={`Representative ${category.label.toLowerCase()} dishes arranged on a warm tabletop`}
        ratio="16:9"
        priority
      />
    </div>
  </header>

  <section class="section tinted" aria-labelledby="category-recipes-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Browse the collection</p>
          <h2 id="category-recipes-title">{category.label} recipes</h2>
        </div>
        <p class="lede">
          Follow the suggested order or choose the dish that fits your table,
          timing, and cooking setup.
        </p>
      </div>
      {
        recipes.length > 0 ? (
          <div class="card-grid">
            {recipes.map((recipe) => (
              <RecipeCard
                {recipe}
                href={registryPathById(registry, recipe.id)}
              />
            ))}
          </div>
        ) : (
          <div class="empty-state">No recipe drafts in this category.</div>
        )
      }
    </div>
  </section>
</BaseLayout>
