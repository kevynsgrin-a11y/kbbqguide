---
import registryData from '../../data/url-registry.json';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DisabledForm from '../components/DisabledForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbJsonLd } from '../lib/seo';
import { registryPathById, type UrlRegistry } from '../lib/url-registry';

const registry = registryData as UrlRegistry;
const path = registryPathById(registry, 'SYS_CLASS');
---

<BaseLayout
  title="Live Korean BBQ Class Preview"
  description="A disabled preview of a possible live Korean BBQ planning and cooking class with no schedule, price, instructor claim, or waitlist collection."
  canonicalPath={path}
  jsonLd={[
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Live Class', path },
    ]),
  ]}
>
  <header class="category-hero">
    <div class="shell reading-width">
      <Breadcrumbs
        items={[{ label: 'Home', href: '/' }, { label: 'Live Class' }]}
      />
      <p class="eyebrow">Concept only · no class scheduled</p>
      <h1>Practice the table as a system.</h1>
      <p class="lede">
        A possible class would cover menu scope, appliance-setting decisions,
        raw/cooked zones, batch flow, thermometer cues, ssam service, and
        cleanup. Instructor, curriculum, platform, date, capacity, price, refund
        terms, and accessibility are unapproved.
      </p>
    </div>
  </header>
  <section class="section tinted">
    <div class="shell support-grid">
      <section class="support-card">
        <h2>Before class</h2><p>
          Confirm equipment approval, ingredient labels, substitutions,
          camera/access needs, and the exact recipe review status.
        </p>
      </section>
      <section class="support-card">
        <h2>During class</h2><p>
          Keep safety instruction adjacent to the action, allow pauses and
          questions, and provide non-video access to the complete written
          method.
        </p>
      </section>
      <section class="support-card">
        <h2>After class</h2><p>
          Provide storage and cleanup guidance, accessible materials, correction
          channels, and no unsupported certificate or mastery claim.
        </p>
      </section>
      <section class="support-card">
        <h2>Human gate</h2><p>
          Food-safety, Korean-language/cultural, instructional, accessibility,
          legal, platform, and test-kitchen approval are required.
        </p>
      </section>
    </div>
  </section>
  <section class="section">
    <div class="shell reading-width">
      <DisabledForm
        formId="class-waitlist"
        title="Class waitlist preview"
        fields={[
          { label: 'Email address', type: 'email' },
          { label: 'Class interest' },
        ]}
        buttonLabel="Waitlist disabled"
        explanation="No class, provider, consent workflow, price, schedule, or instructor is approved."
      />
    </div>
  </section>
</BaseLayout>
