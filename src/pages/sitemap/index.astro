---
import { getCollection } from 'astro:content';
import registryData from '../../../data/url-registry.json';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MediaPlaceholder from '../../components/MediaPlaceholder.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isRecipePublishable } from '../../lib/publication-governance';
import { releaseState } from '../../lib/release-state';
import { itemListJsonLd } from '../../lib/seo';
import { registryPathById, type UrlRegistry } from '../../lib/url-registry';
import type { CompleteRecipe } from '../../schemas/recipe';

const registry = registryData as UrlRegistry;
const visibleRecipeIds = new Set(
  (await getCollection('recipes'))
    .map((entry) => entry.data)
    .filter(
      (recipe): recipe is CompleteRecipe =>
        recipe.contentStatus === 'complete' &&
        (releaseState.mode === 'restricted-preview' ||
          isRecipePublishable(recipe)),
    )
    .map((recipe) => recipe.id),
);
const renderedIds = new Set([
  'SYS_HOME',
  'SYS_START',
  'SYS_RECIPES',
  'CAT_MEAT',
  'CAT_SEAFOOD',
  'CAT_BANCHAN',
  'CAT_FRESH',
  'CAT_SAUCES',
  'CAT_DESSERTS',
  'SYS_GUIDES',
  ...Array.from(
    { length: 12 },
    (_, index) => `G${String(index + 1).padStart(2, '0')}`,
  ),
  'SYS_MENUS',
  'MENU_2',
  'MENU_4',
  'MENU_8',
  'SYS_TOOLS',
  'SYS_SITEMAP',
  'SYS_SHOP',
  'SYS_NEWSLETTER',
  'POL_AFFILIATE',
  'POL_SPONSORED',
  'SYS_ABOUT',
  'SYS_CONTACT',
  'POL_PRIVACY',
  'POL_TERMS',
  'POL_ACCESSIBILITY',
  'POL_EDITORIAL',
  'POL_TESTING',
  'POL_CORRECTIONS',
  'SYS_CLASS',
  'SYS_MEDIA_KIT',
  'SYS_LICENSING',
  'SYS_PARTNERSHIPS',
  ...registry.entries
    .filter(
      (entry) => entry.type === 'recipe' && visibleRecipeIds.has(entry.id),
    )
    .map((entry) => entry.id),
]);
const entries = registry.entries.filter((entry) => renderedIds.has(entry.id));
const groups = [
  { title: 'Start and plan', types: ['SYS_HOME', 'SYS_START', 'SYS_TOOLS'] },
  {
    title: 'Recipe collections',
    types: [
      'SYS_RECIPES',
      'CAT_MEAT',
      'CAT_SEAFOOD',
      'CAT_BANCHAN',
      'CAT_FRESH',
      'CAT_SAUCES',
      'CAT_DESSERTS',
    ],
  },
  {
    title: 'Guides',
    types: [
      'SYS_GUIDES',
      ...entries
        .filter((entry) => entry.type === 'guide')
        .map((entry) => entry.id),
    ],
  },
  { title: 'Menus', types: ['SYS_MENUS', 'MENU_2', 'MENU_4', 'MENU_8'] },
  {
    title: 'Revenue and communication previews',
    types: [
      'SYS_SHOP',
      'SYS_NEWSLETTER',
      'SYS_CLASS',
      'SYS_MEDIA_KIT',
      'SYS_LICENSING',
      'SYS_PARTNERSHIPS',
    ],
  },
  {
    title: 'Disclosure policies',
    types: ['POL_AFFILIATE', 'POL_SPONSORED'],
  },
  {
    title: 'Trust, policies, and corrections',
    types: [
      'SYS_ABOUT',
      'SYS_CONTACT',
      'POL_PRIVACY',
      'POL_TERMS',
      'POL_ACCESSIBILITY',
      'POL_EDITORIAL',
      'POL_TESTING',
      'POL_CORRECTIONS',
    ],
  },
  {
    title:
      releaseState.mode === 'restricted-preview'
        ? 'Recipe drafts'
        : 'Published recipes',
    types: entries
      .filter((entry) => entry.type === 'recipe')
      .map((entry) => entry.id),
  },
];
const path = registryPathById(registry, 'SYS_SITEMAP');
---

<BaseLayout
  title="HTML Sitemap"
  description="A human-readable map of the routes eligible for this KBBQGuide release state."
  canonicalPath={path}
  jsonLd={releaseState.isIndexable
    ? [
        itemListJsonLd(
          'KBBQGuide public routes',
          entries.map((entry) => ({ name: entry.title, path: entry.path })),
        ),
      ]
    : []}
>
  <header class="category-hero">
    <div class="shell reading-width">
      <Breadcrumbs
        items={[
          { label: 'Home', href: registryPathById(registry, 'SYS_HOME') },
          { label: 'HTML Sitemap' },
        ]}
      />
      <p class="eyebrow">
        {
          releaseState.mode === 'restricted-preview'
            ? 'Restricted preview routes'
            : 'Release-eligible routes'
        }
      </p>
      <h1>Everything available in this release.</h1>
      <p class="lede">
        This map includes the trust routes available in this release. A
        legal-dependent route remains a transparent, non-collecting status page
        until its accountable facts are approved; it never uses a placeholder
        identity, mailbox, retention period, or terms text.
      </p>
      <MediaPlaceholder
        mediaId="POLICY-tabletop-texture"
        label="Editorial sitemap banner"
        altDraft="Decorative charcoal tabletop texture with cream ceramic and brushed metal"
        ratio="16:9"
        class="policy-media-banner"
        showCredit
      />
    </div>
  </header>

  <section class="section tinted">
    <div class="shell sitemap-grid">
      {
        groups.map((group) => (
          <section class="support-card">
            <h2>{group.title}</h2>
            <ul class="plain-list">
              {group.types.map((id) => {
                const entry = entries.find((candidate) => candidate.id === id);
                if (!entry) return null;
                return (
                  <li>
                    <a href={entry.path}>{entry.title}</a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>
