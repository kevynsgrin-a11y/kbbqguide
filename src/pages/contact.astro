---
import registryData from '../../data/url-registry.json';
import TrustRouteStatus from '../components/TrustRouteStatus.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  trustRouteConfig,
  trustRoutePublication,
  trustRouteRobotsContent,
} from '../lib/trust-routes';
import { registryPathById, type UrlRegistry } from '../lib/url-registry';

const registry = registryData as UrlRegistry;
const path = registryPathById(registry, 'SYS_CONTACT');
const publication = trustRoutePublication('contact');
const robotsContent = trustRouteRobotsContent('contact');
const contact = trustRouteConfig.contact;
---

<BaseLayout
  title="Contact"
  description="KBBQGuide public contact and inquiry handling status."
  canonicalPath={path}
  {robotsContent}
>
  <section class="section">
    <div class="shell reading-width policy-stack">
      <p class="eyebrow">Contact</p>
      <h1>Contact handling</h1>
      {
        publication.status === 'approved' ? (
          <>
            <p class="lede">
              Send a message to{' '}
              <a href={`mailto:${contact.publicContactEmail!}`}>
                {contact.publicContactEmail}
              </a>
              .
            </p>
            <p>
              We handle contact inquiries according to this published retention
              statement: {contact.inquiryDataRetention}
            </p>
          </>
        ) : (
          <>
            <p class="lede">
              A public mailbox or message form is intentionally not active yet.
            </p>
            <TrustRouteStatus
              routeLabel="Contact route"
              blockers={publication.blockers}
            />
          </>
        )
      }
    </div>
  </section>
</BaseLayout>
