---
import registryData from '../../../data/url-registry.json';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EditorialHero from '../../components/EditorialHero.astro';
import MediaPlaceholder from '../../components/MediaPlaceholder.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { guides, guidesIndexPublication } from '../../lib/guides';
import {
  isNonRecipePublishable,
  nonRecipePageEligibility,
} from '../../lib/nonrecipe-publication-governance';
import { releaseState } from '../../lib/release-state';
import { breadcrumbJsonLd, itemListJsonLd } from '../../lib/seo';
import { registryPathById, type UrlRegistry } from '../../lib/url-registry';

const registry = registryData as UrlRegistry;
const path = registryPathById(registry, 'SYS_GUIDES');
const publication = nonRecipePageEligibility(
  guidesIndexPublication,
  releaseState,
);
const visibleGuides = releaseState.isIndexable
  ? guides.filter((guide) => isNonRecipePublishable(guide.publication))
  : guides;
const guideItems = visibleGuides.map((guide) => ({
  name: guide.title,
  path: registryPathById(registry, guide.id),
}));
const structuredData =
  publication.emitsJsonLd && guideItems.length > 0
    ? [
        breadcrumbJsonLd([
          { name: 'Home', path: registryPathById(registry, 'SYS_HOME') },
          { name: 'Guides', path },
        ]),
        itemListJsonLd('Korean BBQ planning guides', guideItems),
      ]
    : [];
---

<BaseLayout
  title="Korean BBQ Planning Guides"
  description="Twelve practical Korean BBQ guides covering setup, safety, pantry, meat, seafood, ssam, menus, timelines, banchan, cleanup, and leftovers."
  canonicalPath={path}
  jsonLd={structuredData}
  robotsContent={publication.robotsContent}
>
  <EditorialHero
    mediaId="SYS_GUIDES-hero"
    label="Korean barbecue planning guides"
    altDraft="A clean Korean barbecue planning workspace with table map and approved electric grill"
    class="category-hero guide-hero"
  >
    <Breadcrumbs
      items={[
        { label: 'Home', href: registryPathById(registry, 'SYS_HOME') },
        { label: 'Guides' },
      ]}
    />
    <p class="eyebrow">Twelve decision guides</p>
    <h1>Plan the room, table, work, and cleanup.</h1>
    <p class="lede">
      Move from room setup to cleanup with practical checkpoints that respect
      different homes, equipment, appetites, and ways of building the table.
    </p>
  </EditorialHero>

  <section class="section tinted" aria-labelledby="guide-index-title">
    <div class="shell">
      <h2 id="guide-index-title">All guides</h2>
      <div class="card-grid guide-grid">
        {
          visibleGuides.map((guide, index) => (
            <article class="support-card guide-card">
              <MediaPlaceholder
                mediaId={`${guide.id}-hero`}
                label={`${guide.title} thumbnail`}
                altDraft={`Editorial image for ${guide.title}`}
                ratio="16:9"
              />
              <p class="eyebrow">Guide {String(index + 1).padStart(2, '0')}</p>
              <h3>
                <a href={registryPathById(registry, guide.id)}>{guide.title}</a>
              </h3>
              <p>{guide.description}</p>
            </article>
          ))
        }
        {
          visibleGuides.length === 0 && (
            <div class="empty-state">
              Guides are published after named human review is complete.
            </div>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
