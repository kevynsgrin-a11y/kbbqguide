---
import { getCollection } from 'astro:content';
import registryData from '../../data/url-registry.json';
import EditorialBanner from '../components/EditorialBanner.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import RecipeCard from '../components/RecipeCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../lib/categories';
import { resolveMedia } from '../lib/media';
import { isRecipePublishable } from '../lib/publication-governance';
import { publisherWebSiteJsonLd } from '../lib/publisher-schema';
import { releaseState } from '../lib/release-state';
import { itemListJsonLd } from '../lib/seo';
import { registryPathById, type UrlRegistry } from '../lib/url-registry';
import type { CompleteRecipe } from '../schemas/recipe';

const registry = registryData as UrlRegistry;
// Phase 10 (P1-8): scoped synthetic-content disclosure adjacent to the home hero.
const heroMedia = resolveMedia('HOME-gathering-hero');
const allRecipes = (await getCollection('recipes'))
  .map((entry) => entry.data)
  .filter(
    (recipe): recipe is CompleteRecipe => recipe.contentStatus === 'complete',
  )
  .sort((a, b) => a.publicReleaseOrder - b.publicReleaseOrder);
const recipes = allRecipes.filter(
  (recipe) =>
    releaseState.mode === 'restricted-preview' || isRecipePublishable(recipe),
);
const featured = recipes.slice(0, 3);
const canonicalPath = registryPathById(registry, 'SYS_HOME');
const categoryList = itemListJsonLd(
  'Korean BBQ recipe categories',
  categories.map((category) => ({
    name: category.label,
    path: registryPathById(registry, category.id),
  })),
);
const publisherWebsiteGraph = publisherWebSiteJsonLd();
const structuredData = releaseState.isIndexable
  ? [
      categoryList,
      ...(publisherWebsiteGraph === null ? [] : [publisherWebsiteGraph]),
    ]
  : [];
---

<BaseLayout
  title="Korean BBQ at Home, Made Clear"
  description={releaseState.mode === 'restricted-preview'
    ? 'Build a complete Korean BBQ table at home with structured recipe drafts, practical menus, planning tools, and visible food-safety cues.'
    : 'Published Korean BBQ recipes, practical menus, and planning tools are released after named human review.'}
  canonicalPath={canonicalPath}
  jsonLd={structuredData}
  pageClass="home-page"
  socialImage="/social/kbbqguide-home.jpg"
  socialImageAlt="Four friends sharing a Korean barbecue table around an indoor grill"
  socialImageWidth={1200}
  socialImageHeight={630}
>
  <section class="marketing-hero">
    <MediaPlaceholder
      mediaId="HOME-gathering-hero"
      label="Friends gathering around a Korean barbecue table"
      altDraft="Four adult friends sharing a Korean barbecue table around an indoor electric grill"
      ratio="3:2"
      priority
      class="home-hero-media"
      sizes="100vw"
    />
    <div class="home-hero-scrim" aria-hidden="true"></div>
    {
      heroMedia && (
        <p class="home-hero-disclosure">
          {heroMedia.provenance.disclosure} {heroMedia.credit}
        </p>
      )
    }
    <div class="shell home-hero-content">
      <div class="hero-copy">
        <p class="eyebrow">Korean BBQ, from first prep to final plate</p>
        <h1>The whole Korean BBQ table, made clear.</h1>
        <p class="lede">
          KBBQGuide brings grilling, banchan, seafood, fresh sides, sauces, and
          a sweet finish into one calm system—with the timing, sensory cues, and
          safety decisions visible when you need them.
        </p>
        {
          recipes.length > 0 && (
            <div class="hero-actions">
              <a
                class="button"
                href={registryPathById(registry, 'SYS_RECIPES')}
              >
                Explore all recipes
              </a>
              <a
                class="button secondary"
                href={registryPathById(registry, 'CAT_MEAT')}
              >
                Fire up the grill
              </a>
            </div>
          )
        }
        <dl class="hero-stats" aria-label="KBBQGuide library overview">
          <div>
            <dt>{recipes.length}</dt>
            <dd>
              {
                releaseState.mode === 'restricted-preview'
                  ? 'recipe drafts'
                  : 'published recipes'
              }
            </dd>
          </div>
          <div><dt>6</dt><dd>table sections</dd></div>
          <div><dt>1</dt><dd>clear plan</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="categories-title">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Build your table</p>
          <h2 id="categories-title">Choose your starting point</h2>
        </div>
        <p class="lede">
          Start with the sizzle, the sides, or the sauce. Every section is
          organized around the decisions that make dinner easier.
        </p>
      </div>
      <div class="card-grid">
        {
          categories.map((category) => (
            <article class="category-card">
              <a href={registryPathById(registry, category.id)}>
                <MediaPlaceholder
                  mediaId={`${category.id}-hero`}
                  label={`${category.label} at the table`}
                  altDraft={`A representative ${category.label.toLowerCase()} tabletop arrangement`}
                  ratio="16:9"
                />
                <div class="category-card-content">
                  <p class="eyebrow">{category.eyebrow}</p>
                  <h3>{category.label}</h3>
                  <p>{category.description}</p>
                  <p class="card-meta">
                    <span>
                      {
                        recipes.filter(
                          (recipe) => recipe.category === category.slug,
                        ).length
                      }{' '}
                      recipes
                    </span>
                  </p>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="section tinted" aria-labelledby="featured-title">
        <div class="shell">
          <div class="section-heading">
            <div>
              <p class="eyebrow">A table worth gathering around</p>
              <h2 id="featured-title">Start with three KBBQ essentials</h2>
            </div>
            <p class="lede">
              Pair a savory grill centerpiece with seafood and banchan, then use
              the related-recipe paths to round out the meal.
            </p>
          </div>
          <div class="card-grid">
            {featured.map((recipe) => (
              <RecipeCard
                {recipe}
                href={registryPathById(registry, recipe.id)}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <EditorialBanner
    mediaId="HOME-editorial-banner"
    label="Friends sharing ssam and banchan"
    altDraft="Adult friends passing lettuce wraps and banchan across a Korean barbecue table"
  >
    <p class="eyebrow">The ritual is shared</p>
    <h2 id="media-contract-title">Pass a dish. Build a wrap. Stay awhile.</h2>
    <p class="lede">
      The best table is not a performance. It is a sequence of small acts—one
      clean platter, one hot batch, one fresh leaf, passed from hand to hand.
      Campaign imagery is visibly disclosed and remains pending human review.
    </p>
    <a class="button" href={registryPathById(registry, 'SYS_START')}>
      Plan your first table
    </a>
  </EditorialBanner>
</BaseLayout>
