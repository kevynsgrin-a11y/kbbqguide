PUBLIC_SITE_NAME=KBBQGuide
PUBLIC_SITE_URL=https://kbbqguide.com
PUBLIC_GA4_ID={{GA4_ID}}
PUBLIC_SEARCH_CONSOLE_TOKEN={{SEARCH_CONSOLE_TOKEN}}
# 2026-09-22 launch attempt, recorded truthfully: the owner approved public
# launch, but the built emission layer stayed empty — 0/80 recipes carry
# review-gate evidence (testCook/foodSafety/koreanLanguage/editorial), so the
# sitemap and Recipe JSON-LD emitted nothing and the launch validator refused
# the build (by design). Posture reverted to this safe default until the
# per-recipe human review lanes complete or a sanctioned waiver flow is built.
KBBQGUIDE_RELEASE_MODE=public-noindex-preview
KBBQGUIDE_ACCESS_CONTROL=
KBBQGUIDE_ACCESS_VERIFIED=
KBBQGUIDE_PUBLIC_RELEASE_APPROVED=
KBBQGUIDE_INDEXING_APPROVED=
